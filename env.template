# HashPost Development Environment Variables
# Copy this file to .env and adjust values as needed

# Database Configuration
DATABASE_URL=postgres://hashpost_pds:password@localhost:5432/hashpost_pds_dev
APPVIEW_DATABASE_URL=postgres://hashpost_appview:password@localhost:5432/hashpost_appview_dev?sslmode=disable

# Test Database Configuration (for integration tests)
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_USER=hashpost
TEST_DB_PASSWORD=password
TEST_DB_NAME=postgres

# PDS Database Configuration
PDS_DATABASE_URL=postgres://hashpost_pds:password@localhost:5432/hashpost_pds_dev

# AppView Database Configuration  
APPVIEW_DATABASE_URL=postgres://hashpost_appview:password@localhost:5432/hashpost_appview_dev?sslmode=disable

# External Services
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222
PDS_URL=http://localhost:8080

# Logging
LOG_LEVEL=debug

# Development Settings
ENV=development

# External PDS Support
ENABLE_EXTERNAL_PDS=true
PDS_PUBLIC_KEY_CACHE_TTL=24h
OAUTH_CLIENT_NAME=HashPost
