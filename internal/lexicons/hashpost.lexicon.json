{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "lexicons": [
    {
      "id": "com.hashpost.feed.post",
      "version": "0.0.1",
      "defs": {
        "main": {
          "type": "object",
          "required": ["text", "createdAt"],
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 3000
            },
            "createdAt": {
              "type": "string",
              "format": "date-time"
            },
            "reply": {
              "type": "object",
              "properties": {
                "root": {
                  "type": "string"
                },
                "parent": {
                  "type": "string"
                }
              }
            },
            "embed": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["image", "link", "quote"]
                },
                "url": {
                  "type": "string"
                },
                "alt": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "com.hashpost.forum.subforum",
      "version": "0.0.1",
      "defs": {
        "main": {
          "type": "object",
          "required": ["name", "slug", "description"],
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 100
            },
            "slug": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            },
            "description": {
              "type": "string",
              "maxLength": 500
            },
            "prefixType": {
              "type": "string",
              "enum": ["h", "r", "t"],
              "description": "Subforum prefix type: h (HashPost), r (regional), t (topical)"
            },
            "createdAt": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    },
    {
      "id": "com.hashpost.feed.comment",
      "version": "0.0.1",
      "defs": {
        "main": {
          "type": "object",
          "required": ["text", "post", "createdAt"],
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 3000
            },
            "post": {
              "type": "string",
              "description": "AT-URI of the post this comment belongs to"
            },
            "parent": {
              "type": "string",
              "description": "AT-URI of parent comment for nested replies"
            },
            "createdAt": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    }
  ]
}